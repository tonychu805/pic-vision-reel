{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "picvision-reel-cf-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "picvision-reel",
      "routes": [
        {
          "pattern": "share.picvisionai.com",
          "custom_domain": true
        }
      ]
    }
  }
}
